{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/platform/consumer-execution/consumer-execution-embodiment-plan.v3.schema.json",
  "title": "Consumer execution embodiment plan v3",
  "description": "Closed compiler-to-runtime envelope. It contains no nodes[].operations[] or node.transition alternate topology.",
  "type": "object",
  "additionalProperties": false,
  "required": ["executionEmbodimentPlanType", "target", "capabilityId", "canonicalGraph", "canonicalGraphDigest", "realizationOverlay", "realizedGraphDigest", "sourceMap", "contractCatalog", "bindingAuthorities", "cellProtocolVersion", "conformanceClosures", "expectedCanonicalTopology", "executionPolicy", "effectPolicy"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "executionEmbodimentPlanType": { "const": "consumer-execution-embodiment-plan.v3" },
    "target": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "capabilityId": { "type": "string", "minLength": 1 },
    "canonicalGraph": { "$ref": "https://schemas.scenario-driven.dev/kernel/sda-semantic-execution-graph.v1.schema.json" },
    "canonicalGraphDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "realizationOverlay": { "$ref": "https://schemas.scenario-driven.dev/kernel/execution-graph-realization-overlay.v1.schema.json" },
    "realizedGraphDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sourceMap": { "type": "object" },
    "contractCatalog": { "type": "object" },
    "bindingAuthorities": { "type": "array", "items": { "type": "object" } },
    "cellProtocolVersion": { "const": "cell-execution-protocol.v1" },
    "conformanceClosures": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "expectedCanonicalTopology": { "type": "object" },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheduler", "logicalOrdering", "undeclaredControlFlow"],
      "properties": {
        "scheduler": { "const": "graph-token-scheduler.v1" },
        "logicalOrdering": { "const": "deterministic" },
        "undeclaredControlFlow": { "const": "reject" }
      }
    },
    "effectPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graphIssuedContextRequired", "providerTestimonyRequired"],
      "properties": {
        "graphIssuedContextRequired": { "const": true },
        "providerTestimonyRequired": { "const": true }
      }
    }
  }
}
