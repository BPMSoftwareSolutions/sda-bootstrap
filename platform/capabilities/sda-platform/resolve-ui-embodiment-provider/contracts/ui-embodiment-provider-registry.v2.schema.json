{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/platform/ui-embodiment/ui-embodiment-provider-registry.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryType", "protocolType", "protocolSchemaDigest", "providers", "catalogDigest"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "registryType": { "const": "ui-embodiment-provider-registry.v2" },
    "protocolType": { "const": "sda-ui-presentation-ir.v3" },
    "protocolSchemaDigest": { "$ref": "#/$defs/digest" },
    "providers": { "type": "array", "items": { "$ref": "#/$defs/provider" } },
    "catalogDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "providerVersion", "providerDigest", "admissionStatus", "targetKinds", "priority", "features", "evidenceCapabilities", "observationCapability", "knownConstraints", "implementationRef"],
      "properties": {
        "providerId": { "$ref": "#/$defs/id" },
        "providerVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "providerDigest": { "$ref": "#/$defs/digest" },
        "admissionStatus": { "enum": ["PLANNING_ONLY", "PROVIDER_ADMITTED", "NATIVE_PROOF_ADMITTED"] },
        "targetKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "priority": { "type": "integer", "minimum": 0 },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capabilityId", "mechanicId", "versionRange"],
            "properties": {
              "capabilityId": { "$ref": "#/$defs/id" },
              "mechanicId": { "$ref": "#/$defs/id" },
              "versionRange": { "const": "1.x" }
            }
          }
        },
        "evidenceCapabilities": { "type": "array", "uniqueItems": true, "items": { "enum": ["ACCESSIBILITY", "ADAPTATION", "OBSERVATION"] } },
        "observationCapability": { "enum": ["PLAN_ONLY", "STRUCTURAL", "NATIVE"] },
        "knownConstraints": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "implementationRef": { "type": "string", "minLength": 1 }
      }
    }
  }
}
