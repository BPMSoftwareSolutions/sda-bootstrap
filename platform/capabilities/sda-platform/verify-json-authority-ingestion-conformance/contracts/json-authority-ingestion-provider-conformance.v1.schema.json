{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/json-ingestion/json-authority-ingestion-provider-conformance.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "lifecycle", "providerObservation", "authorityDigests", "fixtureManifestRef", "fixtureManifestDigest", "fixtureSetDigest", "partitions", "findings", "disposition", "receiptDigest", "receiptDigestAlgorithm"],
  "properties": {
    "contractId": {"const": "json-authority-ingestion-provider-conformance.v1"},
    "lifecycle": {"enum": ["PROPOSED", "ADMITTED"]},
    "providerObservation": {"$ref": "#/$defs/providerObservation"},
    "authorityDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "parser", "schemaResolver", "referenceResolver"],
      "properties": {
        "provider": {"$ref": "#/$defs/digest"},
        "parser": {"$ref": "#/$defs/digest"},
        "schemaResolver": {"$ref": "#/$defs/digest"},
        "referenceResolver": {"$ref": "#/$defs/digest"}
      }
    },
    "fixtureManifestRef": {"const": "capabilities/sda-platform/verify-json-authority-ingestion-conformance/fixtures/fixture-manifest.authority.json"},
    "fixtureManifestDigest": {"$ref": "#/$defs/digest"},
    "fixtureSetDigest": {"$ref": "#/$defs/digest"},
    "partitions": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/partition"},
      "allOf": [
        {"contains": {"type": "object", "properties": {"partitionId": {"const": "EXACT_SOURCE_BYTES_AND_POINTERS"}}, "required": ["partitionId"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"partitionId": {"const": "STRICT_UTF8_AND_LOSSLESS_JSON"}}, "required": ["partitionId"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"partitionId": {"const": "DUPLICATE_OBJECT_KEYS"}}, "required": ["partitionId"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"partitionId": {"const": "CANONICAL_JSON_IDENTITY"}}, "required": ["partitionId"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"partitionId": {"const": "DECLARED_SCHEMA_AUTHORITY"}}, "required": ["partitionId"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"partitionId": {"const": "SCHEMA_VALIDATION"}}, "required": ["partitionId"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"partitionId": {"const": "DECLARED_VERSION_POLICY"}}, "required": ["partitionId"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"partitionId": {"const": "ADMITTED_REFERENCE_CLOSURE"}}, "required": ["partitionId"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"partitionId": {"const": "SOURCE_CLASS_NON_ESCALATION"}}, "required": ["partitionId"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"partitionId": {"const": "TYPED_DIAGNOSTICS_AND_DISPOSITIONS"}}, "required": ["partitionId"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"partitionId": {"const": "PROVIDER_AND_AUTHORITY_IDENTITIES"}}, "required": ["partitionId"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"partitionId": {"const": "ORDERED_REPRODUCTION_AND_RECEIPT_DIGEST"}}, "required": ["partitionId"]}, "minContains": 1, "maxContains": 1}
      ]
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "disposition": {"enum": ["SDA_JSON_AUTHORITY_INGESTION_PROVIDER_CONFORMANT", "SDA_JSON_AUTHORITY_INGESTION_PROVIDER_OPEN", "SDA_JSON_AUTHORITY_INGESTION_PROVIDER_REJECTED"]},
    "receiptDigest": {"$ref": "#/$defs/digest"},
    "receiptDigestAlgorithm": {"const": "sha256 of canonical recursive-key-order JSON excluding receiptDigest"}
  },
  "allOf": [
    {
      "if": {"type": "object", "properties": {"lifecycle": {"const": "PROPOSED"}}, "required": ["lifecycle"]},
      "then": {"type": "object", "properties": {"providerObservation": {"type": "object", "properties": {"disposition": {"const": "NOT_OBSERVABLE"}}}, "disposition": {"const": "SDA_JSON_AUTHORITY_INGESTION_PROVIDER_OPEN"}}}
    },
    {
      "if": {"type": "object", "properties": {"lifecycle": {"const": "ADMITTED"}}, "required": ["lifecycle"]},
      "then": {"type": "object", "properties": {"providerObservation": {"type": "object", "properties": {"disposition": {"const": "SATISFIED"}}}, "disposition": {"const": "SDA_JSON_AUTHORITY_INGESTION_PROVIDER_CONFORMANT"}}}
    },
    {
      "if": {"type": "object", "properties": {"disposition": {"const": "SDA_JSON_AUTHORITY_INGESTION_PROVIDER_CONFORMANT"}}, "required": ["disposition"]},
      "then": {
        "type": "object",
        "properties": {
          "partitions": {"type": "array", "items": {"type": "object", "properties": {"disposition": {"const": "SATISFIED"}, "evidenceDigests": {"type": "array", "minItems": 1}}, "required": ["disposition", "evidenceDigests"]}},
          "findings": {"type": "array", "maxItems": 0}
        }
      }
    },
    {
      "if": {"type": "object", "properties": {"disposition": {"const": "SDA_JSON_AUTHORITY_INGESTION_PROVIDER_OPEN"}}, "required": ["disposition"]},
      "then": {
        "type": "object",
        "properties": {
          "partitions": {
            "type": "array",
            "contains": {"type": "object", "properties": {"disposition": {"const": "NOT_OBSERVABLE"}}, "required": ["disposition"]},
            "allOf": [{"not": {"contains": {"type": "object", "properties": {"disposition": {"const": "NOT_SATISFIED"}}, "required": ["disposition"]}}}]
          },
          "findings": {"type": "array", "minItems": 1}
        }
      }
    },
    {
      "if": {"type": "object", "properties": {"disposition": {"const": "SDA_JSON_AUTHORITY_INGESTION_PROVIDER_REJECTED"}}, "required": ["disposition"]},
      "then": {
        "type": "object",
        "properties": {
          "partitions": {"type": "array", "contains": {"type": "object", "properties": {"disposition": {"const": "NOT_SATISFIED"}}, "required": ["disposition"]}},
          "findings": {"type": "array", "minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "partitionId": {
      "enum": [
        "EXACT_SOURCE_BYTES_AND_POINTERS",
        "STRICT_UTF8_AND_LOSSLESS_JSON",
        "DUPLICATE_OBJECT_KEYS",
        "CANONICAL_JSON_IDENTITY",
        "DECLARED_SCHEMA_AUTHORITY",
        "SCHEMA_VALIDATION",
        "DECLARED_VERSION_POLICY",
        "ADMITTED_REFERENCE_CLOSURE",
        "SOURCE_CLASS_NON_ESCALATION",
        "TYPED_DIAGNOSTICS_AND_DISPOSITIONS",
        "PROVIDER_AND_AUTHORITY_IDENTITIES",
        "ORDERED_REPRODUCTION_AND_RECEIPT_DIGEST"
      ]
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partitionId", "disposition", "evidenceDigests", "reason"],
      "properties": {
        "partitionId": {"$ref": "#/$defs/partitionId"},
        "disposition": {"enum": ["SATISFIED", "NOT_SATISFIED", "NOT_OBSERVABLE"]},
        "evidenceDigests": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
        "reason": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
      },
      "allOf": [
        {"if": {"type": "object", "properties": {"disposition": {"const": "SATISFIED"}}, "required": ["disposition"]}, "then": {"type": "object", "properties": {"evidenceDigests": {"type": "array", "minItems": 1}, "reason": {"type": "null"}}}},
        {"if": {"type": "object", "properties": {"disposition": {"enum": ["NOT_SATISFIED", "NOT_OBSERVABLE"]}}, "required": ["disposition"]}, "then": {"type": "object", "properties": {"reason": {"type": "string", "minLength": 1}}}}
      ]
    },
    "providerObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "providerSourceSet", "implementationVersion", "registryBindingRef", "registryBindingDigest"],
      "properties": {
        "disposition": {"enum": ["SATISFIED", "NOT_OBSERVABLE"]},
        "providerSourceSet": {"type": "array", "items": {"$ref": "#/$defs/sourceBinding"}},
        "implementationVersion": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "registryBindingRef": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "registryBindingDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
      },
      "allOf": [
        {"if": {"type": "object", "properties": {"disposition": {"const": "NOT_OBSERVABLE"}}, "required": ["disposition"]}, "then": {"type": "object", "properties": {"providerSourceSet": {"type": "array", "maxItems": 0}, "implementationVersion": {"type": "null"}, "registryBindingRef": {"type": "null"}, "registryBindingDigest": {"type": "null"}}}},
        {"if": {"type": "object", "properties": {"disposition": {"const": "SATISFIED"}}, "required": ["disposition"]}, "then": {"type": "object", "properties": {"providerSourceSet": {"type": "array", "minItems": 1}, "implementationVersion": {"type": "string", "minLength": 1}, "registryBindingRef": {"type": "string", "minLength": 1}, "registryBindingDigest": {"$ref": "#/$defs/digest"}}}}
      ]
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRef", "sourceDigest"],
      "properties": {"sourceRef": {"type": "string", "minLength": 1}, "sourceDigest": {"$ref": "#/$defs/digest"}}
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "subjectRef", "message"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "subjectRef": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    }
  }
}
