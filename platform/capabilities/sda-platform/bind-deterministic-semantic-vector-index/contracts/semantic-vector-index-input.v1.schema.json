{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/sda-platform/semantic-vector-index-input.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "payload"],
  "properties": {
    "contractId": {"const": "semantic-vector-index-input.v1"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["embeddingModelId", "embeddingParameters", "corpus", "queryTerms", "minimumOverlapScore", "limit", "snapshotDigest", "catalogDigest"],
      "properties": {
        "embeddingModelId": {"type": "string", "minLength": 1},
        "embeddingParameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gramSize", "caseFold"],
          "properties": {
            "gramSize": {"type": "integer", "minimum": 1, "maximum": 8},
            "caseFold": {"type": "boolean"}
          }
        },
        "corpus": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["semanticObjectId", "searchRepresentation", "catalogOrdinal"],
            "properties": {
              "semanticObjectId": {"type": "string", "minLength": 1},
              "searchRepresentation": {"type": "string", "minLength": 1},
              "catalogOrdinal": {"type": "integer", "minimum": 0}
            }
          }
        },
        "queryTerms": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1}},
        "minimumOverlapScore": {"type": "integer", "minimum": 1},
        "limit": {"type": "integer", "minimum": 1, "maximum": 1000},
        "snapshotDigest": {"$ref": "#/$defs/digest"},
        "catalogDigest": {"$ref": "#/$defs/digest"}
      }
    }
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
