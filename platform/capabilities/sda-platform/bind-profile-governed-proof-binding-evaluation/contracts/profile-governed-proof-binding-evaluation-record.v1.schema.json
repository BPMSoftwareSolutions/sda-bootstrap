{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/proof-binding/profile-governed-proof-binding-evaluation-record.v1.schema.json",
  "title": "Profile-governed proof-binding evaluation record",
  "type": "object",
  "additionalProperties": false,
  "required": ["evaluationCaseId", "profileId", "snapshotDigest", "proofObligationId", "subjectSemanticObjectId", "obligationDisposition", "bindingDisposition", "findingCodes", "reproduction"],
  "properties": {
    "evaluationCaseId": {"type": "string", "minLength": 1},
    "profileId": {"type": "string", "minLength": 1},
    "snapshotDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "proofObligationId": {"type": "string", "minLength": 1},
    "subjectSemanticObjectId": {"type": "string", "minLength": 1},
    "obligationDisposition": {"enum": ["SATISFIED", "NOT_SATISFIED", "NOT_OBSERVABLE", "NOT_APPLICABLE"]},
    "bindingDisposition": {"enum": ["BOUND", "REJECTED", "NOT_OBSERVABLE", "NOT_EVALUATED"]},
    "findingCodes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orderedInputDigest", "evaluationRuleIds", "reproductionDisposition"],
      "properties": {
        "orderedInputDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "evaluationRuleIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "reproductionDisposition": {"enum": ["REPRODUCIBLE", "NOT_REPRODUCIBLE"]}
      }
    }
  }
}