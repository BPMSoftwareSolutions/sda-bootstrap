{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/semantic-corpus/semantic-corpus-derivation-carrier.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixtureType", "fixtureId", "scenarioId", "variants", "expected", "provesPartitions"],
  "properties": {
    "fixtureType": {"const": "semantic-corpus-derivation-carrier.v1"},
    "fixtureId": {"$ref": "#/$defs/id"},
    "scenarioId": {
      "enum": [
        "derive-semantic-corpus-records",
        "retain-open-semantic-references",
        "reject-unadmitted-semantic-basis",
        "reject-mixed-semantic-corpus-generation",
        "reproduce-semantic-corpus-derivation"
      ]
    },
    "variants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/variant"}},
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "findingCodes", "objectIds", "relationshipIds"],
      "properties": {
        "disposition": {"enum": ["DERIVED", "OPEN", "REJECTED", "VARIANT_SPECIFIC"]},
        "findingCodes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}},
        "objectIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "relationshipIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "provesPartitions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/partitionId"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variantId", "declaredResourceOrder", "sourceRecords", "mutations"],
      "properties": {
        "variantId": {"$ref": "#/$defs/id"},
        "declaredResourceOrder": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "sourceRecords": {"type": "array", "items": {"$ref": "#/$defs/sourceRecord"}},
        "mutations": {"type": "array", "items": {"$ref": "#/$defs/mutation"}}
      }
    },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceId", "representationKind", "sourceClass", "sourceText", "representation"],
      "properties": {
        "resourceId": {"$ref": "#/$defs/id"},
        "representationKind": {"enum": ["GHERKIN_COMPILATION", "SCHEMA_ADMITTED_JSON", "PROOF_BINDING_RECORD"]},
        "sourceClass": {"enum": ["CANONICAL_AUTHORITY", "ADMITTED_EVIDENCE", "PROJECTION_EVIDENCE"]},
        "sourceText": {"type": "string"},
        "representation": {"type": "object"}
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "value", "expectedDisposition", "expectedFindingCode"],
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "value": {},
        "expectedDisposition": {"enum": ["OPEN", "REJECTED"]},
        "expectedFindingCode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
      }
    },
    "partitionId": {
      "enum": [
        "AUTHORITY_SCHEMA_BOUNDARY",
        "EXACT_LINEAGE_VALIDATION",
        "CANONICAL_OBJECT_DERIVATION",
        "OWNER_SCOPED_IDENTITY",
        "RELATIONSHIP_DERIVATION",
        "OPEN_REFERENCE_NON_INVENTION",
        "PROHIBITED_BASIS_REJECTION",
        "MIXED_GENERATION_REJECTION",
        "SOURCE_CLASS_NON_ESCALATION",
        "DETERMINISTIC_ORDERING",
        "REPRODUCTION_IDENTITY",
        "PROJECTED_INVOCATION_AND_RECEIPT"
      ]
    }
  }
}
