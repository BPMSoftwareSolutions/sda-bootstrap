{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/sda-platform/os-environment-credential-conformance.v1.schema.json",
  "title": "OS environment credential conformance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "conformanceType",
    "lifecycle",
    "mechanicId",
    "mechanicFamily",
    "registryBinding",
    "partitions",
    "counts",
    "findings",
    "disposition",
    "receiptDigest",
    "receiptDigestAlgorithm"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "conformanceType": { "const": "os-environment-credential-conformance.v1" },
    "lifecycle": { "enum": ["PROPOSED", "ADMITTED", "SUPERSEDED", "RETIRED", "HELD"] },
    "mechanicId": { "const": "read-os-environment-credential" },
    "mechanicFamily": { "const": "platform-effect-mechanics.v1" },
    "registryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registryRef", "registryDigest", "pinnedMechanicAuthorityDigests"],
      "properties": {
        "registryRef": { "type": "string", "minLength": 1 },
        "registryDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "pinnedMechanicAuthorityDigests": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "partitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["partitionId", "proves", "disposition"],
        "properties": {
          "partitionId": { "type": "string", "minLength": 1 },
          "proves": { "type": "string", "minLength": 1 },
          "evidenceDigests": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          },
          "disposition": { "enum": ["SATISFIED", "NOT_SATISFIED", "NOT_OBSERVABLE", "NOT_APPLICABLE"] }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partitionCount", "declaredMechanicCount"],
      "properties": {
        "partitionCount": { "type": "integer", "minimum": 1 },
        "declaredMechanicCount": { "type": "integer", "minimum": 1 }
      }
    },
    "findings": { "type": "array", "items": { "type": "object" } },
    "disposition": { "type": "string", "minLength": 1 },
    "receiptDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "receiptDigestAlgorithm": { "type": "string", "minLength": 1 }
  }
}
