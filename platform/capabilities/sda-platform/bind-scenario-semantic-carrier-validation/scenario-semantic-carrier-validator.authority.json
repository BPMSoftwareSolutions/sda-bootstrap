    "carrier repair",
    "canonical graph extraction",
    "projection",
    "provider resolution",
    "fixture invention",
    "review-ready adjudication"
  ],
  "compositionRules": [
    "exact-source-bytes-and-safe-relative-source-identity-required",
    "carrier-source-is-parsed-as-typescript-ast-and-never-executed",
    "only-the-admitted-literal-carrier-export-is-observed",
    "hidden-executable-meaning-rejects-before-carrier-admission",
    "v2-or-v3-schema-and-semantic-reference-closure-required",
    "v3-management-authority-must-be-complete-and-reference-closed",
    "findings-are-deterministically-ordered",
    "receipt-identity-is-derived-from-canonical-json",
    "validator-does-not-extract-or-project"
