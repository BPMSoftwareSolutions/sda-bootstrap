{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/json-ingestion/lossless-json-parse-request.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "source", "parserBinding"],
  "properties": {
    "contractId": {"const": "lossless-json-parse-request.v1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRef", "sourceBytesBase64", "sourceDigest", "sourceByteLength", "mediaType", "textEncoding", "byteOrderMarkPolicy", "jsonPointer"],
      "properties": {
        "sourceRef": {"type": "string", "minLength": 1},
        "sourceBytesBase64": {"$ref": "#/$defs/base64"},
        "sourceDigest": {"$ref": "#/$defs/digest"},
        "sourceByteLength": {"type": "integer", "minimum": 1},
        "mediaType": {"const": "application/json"},
        "textEncoding": {"const": "UTF-8"},
        "byteOrderMarkPolicy": {"enum": ["REJECT", "ALLOW_AND_RETAIN"]},
        "jsonPointer": {"$ref": "#/$defs/jsonPointer"}
      }
    },
    "parserBinding": {"$ref": "#/$defs/authorityBinding"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "base64": {"type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"},
    "jsonPointer": {"type": "string", "pattern": "^(?:|(?:/(?:[^~/]|~0|~1)*)+)$"},
    "authorityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityId", "authorityRef", "authorityDigest"],
      "properties": {
        "authorityId": {"const": "lossless-json-parser.v1"},
        "authorityRef": {"const": "capabilities/sda-platform/parse-lossless-json-document/lossless-json-parser.authority.json"},
        "authorityDigest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
