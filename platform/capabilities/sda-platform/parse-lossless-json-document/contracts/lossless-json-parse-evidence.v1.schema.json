{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/json-ingestion/lossless-json-parse-evidence.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "source", "parserAuthorityDigest", "tokens", "duplicateMembers", "diagnostics", "disposition", "evidenceDigest"],
  "properties": {
    "contractId": {"const": "lossless-json-parse-evidence.v1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRef", "sourceBytesBase64", "sourceDigest", "sourceByteLength", "jsonPointer"],
      "properties": {
        "sourceRef": {"type": "string", "minLength": 1},
        "sourceBytesBase64": {"$ref": "#/$defs/base64"},
        "sourceDigest": {"$ref": "#/$defs/digest"},
        "sourceByteLength": {"type": "integer", "minimum": 1},
        "jsonPointer": {"$ref": "#/$defs/jsonPointer"}
      }
    },
    "parserAuthorityDigest": {"$ref": "#/$defs/digest"},
    "tokens": {"type": "array", "items": {"$ref": "#/$defs/token"}},
    "duplicateMembers": {"type": "array", "items": {"$ref": "#/$defs/duplicateMember"}},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "disposition": {"enum": ["PARSED", "REJECTED"]},
    "evidenceDigest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"disposition": {"const": "PARSED"}}, "required": ["disposition"]},
      "then": {"properties": {"tokens": {"minItems": 1}, "duplicateMembers": {"maxItems": 0}, "diagnostics": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"disposition": {"const": "REJECTED"}}, "required": ["disposition"]},
      "then": {"properties": {"diagnostics": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "base64": {"type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"},
    "jsonPointer": {"type": "string", "pattern": "^(?:|(?:/(?:[^~/]|~0|~1)*)+)$"},
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byteOffset", "line", "column"],
      "properties": {
        "byteOffset": {"type": "integer", "minimum": 0},
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1}
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokenType", "lexemeBase64", "jsonPointer", "start", "end"],
      "properties": {
        "tokenType": {"enum": ["OBJECT_START", "OBJECT_END", "ARRAY_START", "ARRAY_END", "MEMBER_NAME", "STRING", "NUMBER", "TRUE", "FALSE", "NULL"]},
        "lexemeBase64": {"$ref": "#/$defs/base64"},
        "decodedString": {"type": "string"},
        "jsonPointer": {"$ref": "#/$defs/jsonPointer"},
        "start": {"$ref": "#/$defs/position"},
        "end": {"$ref": "#/$defs/position"}
      }
    },
    "duplicateMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decodedName", "firstPointer", "duplicatePointer", "firstStart", "duplicateStart"],
      "properties": {
        "decodedName": {"type": "string"},
        "firstPointer": {"$ref": "#/$defs/jsonPointer"},
        "duplicatePointer": {"$ref": "#/$defs/jsonPointer"},
        "firstStart": {"$ref": "#/$defs/position"},
        "duplicateStart": {"$ref": "#/$defs/position"}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "jsonPointer", "start"],
      "properties": {
        "code": {"enum": ["JSON_SOURCE_DIGEST_MISMATCH", "JSON_BASE64_INVALID", "JSON_UTF8_INVALID", "JSON_BOM_REJECTED", "JSON_PARSE_ERROR", "JSON_DUPLICATE_KEY"]},
        "message": {"type": "string", "minLength": 1},
        "jsonPointer": {"$ref": "#/$defs/jsonPointer"},
        "start": {"$ref": "#/$defs/position"}
      }
    }
  }
}
