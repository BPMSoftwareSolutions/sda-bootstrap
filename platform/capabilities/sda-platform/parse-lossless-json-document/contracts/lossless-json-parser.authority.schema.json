{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/json-ingestion/lossless-json-parser.authority.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "authorityType", "authorityId", "authorityRef", "authorityVersion", "lifecycle", "platformCapabilityId", "authorityDigest", "authorityDigestAlgorithm", "grammar", "encoding", "lexicalGuarantees", "providerObservation"],
  "properties": {
    "$schema": {"const": "contracts/lossless-json-parser.authority.schema.json"},
    "authorityType": {"const": "lossless-json-parser-authority.v1"},
    "authorityId": {"const": "lossless-json-parser.v1"},
    "authorityRef": {"const": "capabilities/sda-platform/parse-lossless-json-document/lossless-json-parser.authority.json"},
    "authorityVersion": {"const": "1.0.0"},
    "lifecycle": {"enum": ["PROPOSED", "ADMITTED"]},
    "platformCapabilityId": {"const": "sda-lossless-json-document-parser.v1"},
    "authorityDigest": {"$ref": "#/$defs/digest"},
    "authorityDigestAlgorithm": {"const": "sha256 of canonical recursive-key-order JSON excluding authorityDigest"},
    "grammar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specificationId", "topLevelValues", "duplicateMemberEquality", "ambientRecoveryAllowed"],
      "properties": {
        "specificationId": {"const": "rfc8259-json-text.v1"},
        "topLevelValues": {"const": "ANY_JSON_VALUE"},
        "duplicateMemberEquality": {"const": "DECODED_UNICODE_SCALAR_SEQUENCE"},
        "ambientRecoveryAllowed": {"const": false}
      }
    },
    "encoding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["textEncoding", "invalidUtf8", "defaultByteOrderMarkPolicy", "unicodeNormalization"],
      "properties": {
        "textEncoding": {"const": "UTF-8"},
        "invalidUtf8": {"const": "REJECT"},
        "defaultByteOrderMarkPolicy": {"const": "REJECT"},
        "unicodeNormalization": {"const": "NONE"}
      }
    },
    "lexicalGuarantees": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "exact-source-bytes-retained",
          "source-digest-recomputed-before-parse",
          "decoded-member-names-retained",
          "duplicate-member-locations-retained",
          "number-lexemes-retained-without-host-coercion",
          "string-lexemes-and-decoded-values-retained",
          "byte-line-column-locations-retained"
        ]
      }
    },
    "providerObservation": {"$ref": "#/$defs/providerObservation"}
  },
  "allOf": [
    {
      "if": {"properties": {"lifecycle": {"const": "ADMITTED"}}, "required": ["lifecycle"]},
      "then": {"properties": {"providerObservation": {"properties": {"disposition": {"const": "SATISFIED"}}}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "providerObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "providerSourceRef", "providerSourceDigest", "implementationVersion"],
      "properties": {
        "disposition": {"enum": ["SATISFIED", "NOT_OBSERVABLE"]},
        "providerSourceRef": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "providerSourceDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "implementationVersion": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"const": "NOT_OBSERVABLE"}}, "required": ["disposition"]},
          "then": {"properties": {"providerSourceRef": {"type": "null"}, "providerSourceDigest": {"type": "null"}, "implementationVersion": {"type": "null"}}}
        },
        {
          "if": {"properties": {"disposition": {"const": "SATISFIED"}}, "required": ["disposition"]},
          "then": {"properties": {"providerSourceRef": {"type": "string", "minLength": 1}, "providerSourceDigest": {"$ref": "#/$defs/digest"}, "implementationVersion": {"type": "string", "minLength": 1}}}
        }
      ]
    }
  }
}
