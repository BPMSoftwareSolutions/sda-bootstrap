  "authorityDigestAlgorithm": "sha256 of canonical recursive-key-order JSON excluding authorityDigest",
  "grammar": {
    "specificationId": "rfc8259-json-text.v1",
    "topLevelValues": "ANY_JSON_VALUE",
    "duplicateMemberEquality": "DECODED_UNICODE_SCALAR_SEQUENCE",
    "ambientRecoveryAllowed": false
  },
  "encoding": {
    "textEncoding": "UTF-8",
    "invalidUtf8": "REJECT",
    "defaultByteOrderMarkPolicy": "REJECT",
    "unicodeNormalization": "NONE"
  },
  "lexicalGuarantees": [
    "exact-source-bytes-retained",
    "source-digest-recomputed-before-parse",
    "decoded-member-names-retained",
    "duplicate-member-locations-retained",
    "number-lexemes-retained-without-host-coercion",
    "string-lexemes-and-decoded-values-retained",
    "byte-line-column-locations-retained"
  ],
  "providerObservation": {
    "disposition": "SATISFIED",
    "providerSourceRef": "languages/typescript/runtimes/node/json-authority-ingestion-provider.mjs",
