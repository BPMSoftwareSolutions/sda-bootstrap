{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/semantic-corpus/semantic-corpus-derivation-rule-set.v1.schema.json",
  "title": "Closed semantic corpus derivation rule set",
  "type": "object",
  "additionalProperties": false,
  "required": ["ruleSetType", "authorityId", "authorityVersion", "lifecycle", "ontologyId", "identityRuleIds", "objectRules", "relationshipRules"],
  "properties": {
    "ruleSetType": {"const": "semantic-corpus-derivation-rule-set.v1"},
    "authorityId": {"type": "string", "minLength": 1},
    "authorityVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "lifecycle": {"const": "ADMITTED"},
    "ontologyId": {"type": "string", "minLength": 1},
    "identityRuleIds": {"const": ["top-level-semantic-object-identity.v1", "owner-scoped-semantic-object-identity.v1"]},
    "objectRules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/objectRule"}},
    "relationshipRules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/relationshipRule"}}
  },
  "$defs": {
    "propertyPath": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "^(?:\\*|[^*/~]+)$"}},
    "collectionPath": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "^(?:\\*|[^*/~]+)$"}, "contains": {"const": "*"}},
    "basisKind": {"enum": ["EXPLICIT_AUTHORITY", "DETERMINISTIC_RULE", "DIRECTORY_PROXIMITY", "MATCHING_PROSE", "LEXICAL_SIMILARITY", "EMBEDDING_SIMILARITY", "MODEL_TESTIMONY"]},
    "representationKind": {"enum": ["GHERKIN_COMPILATION", "SCHEMA_ADMITTED_JSON", "PROOF_BINDING_RECORD"]},
    "sourceClass": {"enum": ["CANONICAL_AUTHORITY", "ADMITTED_EVIDENCE", "PROJECTION_EVIDENCE"]},
    "attributeSelectors": {"type": "object", "additionalProperties": {"$ref": "#/$defs/propertyPath"}},
    "objectRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "representationKind", "collectionPath", "canonicalIdPath", "kind", "identityMode", "lifecycle", "basisKind", "permittedSourceClasses", "attributeSelectors"],
      "properties": {
        "ruleId": {"type": "string", "minLength": 1},
        "representationKind": {"$ref": "#/$defs/representationKind"},
        "collectionPath": {"$ref": "#/$defs/collectionPath"},
        "canonicalIdPath": {"$ref": "#/$defs/propertyPath"},
        "ownerSemanticObjectIdPath": {"$ref": "#/$defs/propertyPath"},
        "searchRepresentationPath": {"$ref": "#/$defs/propertyPath"},
        "kind": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "identityMode": {"enum": ["TOP_LEVEL", "OWNER_SCOPED"]},
        "lifecycle": {"enum": ["PROPOSED", "ADMITTED", "SUPERSEDED", "RETIRED", "HELD"]},
        "basisKind": {"$ref": "#/$defs/basisKind"},
        "permittedSourceClasses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sourceClass"}},
        "attributeSelectors": {"$ref": "#/$defs/attributeSelectors"}
      },
      "allOf": [
        {
          "if": {"type": "object", "properties": {"identityMode": {"const": "OWNER_SCOPED"}}, "required": ["identityMode"]},
          "then": {"type": "object", "properties": {"ownerSemanticObjectIdPath": {"$ref": "#/$defs/propertyPath"}}, "required": ["ownerSemanticObjectIdPath"]},
          "else": {"type": "object", "properties": {"ownerSemanticObjectIdPath": false}}
        }
      ]
    },
    "relationshipRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "representationKind", "collectionPath", "fromSemanticObjectIdPath", "toSemanticObjectIdPath", "kind", "disposition", "endpointPolicy", "basisKind", "permittedSourceClasses"],
      "properties": {
        "ruleId": {"type": "string", "minLength": 1},
        "representationKind": {"$ref": "#/$defs/representationKind"},
        "collectionPath": {"$ref": "#/$defs/collectionPath"},
        "fromSemanticObjectIdPath": {"$ref": "#/$defs/propertyPath"},
        "toSemanticObjectIdPath": {"$ref": "#/$defs/propertyPath"},
        "kind": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "disposition": {"enum": ["DECLARED_RELATIONSHIP", "DETERMINISTIC_DERIVATION"]},
        "endpointPolicy": {"const": "OPEN_IF_ABSENT"},
        "basisKind": {"$ref": "#/$defs/basisKind"},
        "permittedSourceClasses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sourceClass"}}
      }
    }
  }
}
