{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/semantic-corpus/semantic-corpus-derivation-profile.v1.schema.json",
  "title": "Semantic corpus derivation profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["profileType", "authorityId", "authorityVersion", "lifecycle", "ontologyId", "ruleSetId", "requiredReceiptKinds", "permittedSourceClasses", "prohibitedBasisKinds", "recordOrder", "diagnosticPrecedence", "evaluationRuleIds", "reproductionRequired", "outputContractId"],
  "properties": {
    "profileType": {"const": "semantic-corpus-derivation-profile.v1"},
    "authorityId": {"type": "string", "minLength": 1},
    "authorityVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "lifecycle": {"const": "ADMITTED"},
    "ontologyId": {"type": "string", "minLength": 1},
    "ruleSetId": {"type": "string", "minLength": 1},
    "requiredReceiptKinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["GHERKIN_COMPILATION", "JSON_AUTHORITY_INGESTION", "PROOF_BINDING"]}},
    "permittedSourceClasses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["CANONICAL_AUTHORITY", "ADMITTED_EVIDENCE", "PROJECTION_EVIDENCE"]}},
    "prohibitedBasisKinds": {"const": ["DIRECTORY_PROXIMITY", "MATCHING_PROSE", "LEXICAL_SIMILARITY", "EMBEDDING_SIMILARITY", "MODEL_TESTIMONY"]},
    "recordOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectFields", "relationshipFields", "findingFields", "comparator", "discoveryOrderInfluencesOrder"],
      "properties": {
        "objectFields": {"const": ["kind", "semanticObjectId", "sourceRef", "sourcePointer", "derivationRuleId"]},
        "relationshipFields": {"const": ["kind", "fromSemanticObjectId", "toSemanticObjectId", "relationshipId", "derivationRuleId"]},
        "findingFields": {"const": ["code", "subjectRef", "sourceRef", "sourcePointer", "derivationRuleId"]},
        "comparator": {"const": "UTF8_BYTEWISE_ASCENDING"},
        "discoveryOrderInfluencesOrder": {"const": false}
      }
    },
    "diagnosticPrecedence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}},
    "evaluationRuleIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reproductionRequired": {"const": true},
    "outputContractId": {"const": "semantic-corpus-derivation-evidence.v1"}
  }
}
