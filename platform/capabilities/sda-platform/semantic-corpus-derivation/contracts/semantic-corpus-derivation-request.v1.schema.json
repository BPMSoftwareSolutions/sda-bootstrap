{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/semantic-corpus/semantic-corpus-derivation-request.v1.schema.json",
  "title": "Profile-governed semantic corpus derivation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "profile", "snapshotDigest", "ontology", "ruleSet", "ingestionReceipts", "declaredResourceOrder", "sourceRecords", "reproduction"],
  "properties": {
    "contractId": {"const": "semantic-corpus-derivation-request.v1"},
    "profile": {"$ref": "#/$defs/authorityBinding"},
    "snapshotDigest": {"$ref": "#/$defs/digest"},
    "ontology": {"$ref": "#/$defs/authorityBinding"},
    "ruleSet": {"$ref": "#/$defs/authorityBinding"},
    "ingestionReceipts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ingestionReceipt"}
    },
    "declaredResourceOrder": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "sourceRecords": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sourceRecord"}
    },
    "reproduction": {"$ref": "#/$defs/reproduction"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "base64": {"type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"},
    "jsonPointer": {"type": "string", "pattern": "^(?:|(?:/(?:[^~/]|~0|~1)*)+)$"},
    "authorityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityId", "authorityRef", "authorityDigest"],
      "properties": {
        "authorityId": {"type": "string", "minLength": 1},
        "authorityRef": {"type": "string", "minLength": 1},
        "authorityDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "ingestionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptId", "receiptKind", "receiptRef", "receiptDigest", "snapshotDigest", "disposition", "document"],
      "properties": {
        "receiptId": {"type": "string", "minLength": 1},
        "receiptKind": {"enum": ["GHERKIN_COMPILATION", "JSON_AUTHORITY_INGESTION", "PROOF_BINDING"]},
        "receiptRef": {"type": "string", "minLength": 1},
        "receiptDigest": {"$ref": "#/$defs/digest"},
        "snapshotDigest": {"$ref": "#/$defs/digest"},
        "disposition": {"enum": ["ADMITTED", "OPEN", "REJECTED"]},
        "document": {"type": "object"}
      }
    },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceId", "sourceClass", "sourceRef", "sourceBytesBase64", "sourceDigest", "receiptId", "representationKind", "representationRef", "representationPointer", "representationDigest", "representation"],
      "properties": {
        "resourceId": {"type": "string", "minLength": 1},
        "sourceClass": {"enum": ["CANONICAL_AUTHORITY", "ADMITTED_EVIDENCE"]},
        "sourceRef": {"type": "string", "minLength": 1},
        "sourceBytesBase64": {"$ref": "#/$defs/base64"},
        "sourceDigest": {"$ref": "#/$defs/digest"},
        "receiptId": {"type": "string", "minLength": 1},
        "representationKind": {"enum": ["GHERKIN_COMPILATION", "SCHEMA_ADMITTED_JSON", "PROOF_BINDING_RECORD"]},
        "representationRef": {"type": "string", "minLength": 1},
        "representationPointer": {"$ref": "#/$defs/jsonPointer"},
        "representationDigest": {"$ref": "#/$defs/digest"},
        "representation": {}
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orderedInputDigest", "evaluationRuleIds"],
      "properties": {
        "orderedInputDigest": {"$ref": "#/$defs/digest"},
        "evaluationRuleIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
