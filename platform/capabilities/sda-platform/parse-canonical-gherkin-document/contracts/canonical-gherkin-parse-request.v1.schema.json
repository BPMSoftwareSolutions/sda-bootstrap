{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/gherkin/canonical-gherkin-parse-request.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "sourceRef", "sourceBytesBase64", "mediaType", "declaredDialect", "grammarBinding"],
  "properties": {
    "contractId": {"const": "canonical-gherkin-parse-request.v1"},
    "sourceRef": {"type": "string", "minLength": 1},
    "sourceBytesBase64": {"type": "string"},
    "mediaType": {"type": "string", "minLength": 1},
    "declaredDialect": {"type": "string", "minLength": 1},
    "grammarBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platformCapabilityId", "providerAuthorityRef", "providerAuthorityDigest"],
      "properties": {
        "platformCapabilityId": {"const": "sda-canonical-gherkin-grammar.v1"},
        "providerAuthorityRef": {"type": "string", "minLength": 1},
        "providerAuthorityDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
