{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sda.local/artifact-materialization-conformance.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "disposition", "verifiedArtifactCount", "findings", "authorityClaims", "lineage", "verificationContext"],
  "properties": {
    "contractId": {"const": "artifact-materialization-conformance.v1"},
    "disposition": {"enum": ["CONFORMANT", "NON_CONFORMANT"]},
    "verifiedArtifactCount": {"type": "integer"},
    "findings": {"type": "array", "items": {"type": "object"}},
    "verificationContext": {"type": "object", "additionalProperties": true},
    "authorityClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection", "promotion", "behavioralConformance"],
      "properties": {
        "projection": {"const": "NOT_CLAIMED"},
        "promotion": {"const": "NOT_CLAIMED"},
        "behavioralConformance": {"const": "NOT_CLAIMED"}
      }
    },
    "lineage": {"type": "array", "items": {"type": "string"}}
  }
}
