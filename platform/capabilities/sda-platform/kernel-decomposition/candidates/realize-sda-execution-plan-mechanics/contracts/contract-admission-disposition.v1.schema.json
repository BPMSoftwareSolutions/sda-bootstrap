{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sda.local/contract-admission-disposition.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "disposition", "admittedContractId", "contractDigest", "candidateValue", "findings", "authorityClaims", "lineage"],
  "properties": {
    "contractId": {"const": "contract-admission-disposition.v1"},
    "disposition": {"enum": ["ADMITTED", "REJECTED"]},
    "admittedContractId": {"type": "string"},
    "contractDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidateValue": {"type": "object"},
    "findings": {"type": "array", "items": {"type": "object"}},
    "authorityClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection", "promotion", "behavioralConformance"],
      "properties": {
        "projection": {"const": "NOT_CLAIMED"},
        "promotion": {"const": "NOT_CLAIMED"},
        "behavioralConformance": {"const": "NOT_CLAIMED"}
      }
    },
    "lineage": {"type": "array", "items": {"type": "string"}}
  }
}
