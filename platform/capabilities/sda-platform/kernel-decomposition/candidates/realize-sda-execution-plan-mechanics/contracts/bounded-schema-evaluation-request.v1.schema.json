{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sda.local/bounded-schema-evaluation-request.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "carrierType", "candidateValue", "declaredFields", "schemaBound", "transformationDisposition"],
  "properties": {
    "contractId": {"const": "bounded-schema-evaluation-request.v1"},
    "carrierType": {"const": "bounded-schema-evaluation-request.v1"},
    "candidateValue": {"type": "object"},
    "declaredFields": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "schemaBound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaId", "schemaDigest", "allowedFields"],
      "properties": {
        "schemaId": {"type": "string", "minLength": 1},
        "schemaDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "allowedFields": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "transformationDisposition": {"type": "string", "minLength": 1}
  }
}
