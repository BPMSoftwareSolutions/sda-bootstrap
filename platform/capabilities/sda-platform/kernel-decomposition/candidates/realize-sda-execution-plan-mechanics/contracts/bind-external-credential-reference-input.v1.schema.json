{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sda.local/bind-external-credential-reference-input.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "carrierType",
    "priorDisposition",
    "priorFindings",
    "payload",
    "mechanicPayloads"
  ],
  "properties": {
    "contractId": {
      "const": "bind-external-credential-reference-input.v1"
    },
    "carrierType": {
      "const": "bind-external-credential-reference-input.v1"
    },
    "priorDisposition": {
      "type": "string",
      "minLength": 1
    },
    "priorFindings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "mechanicPayloads": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
