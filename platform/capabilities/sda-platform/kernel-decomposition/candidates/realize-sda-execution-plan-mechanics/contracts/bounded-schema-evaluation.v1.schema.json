{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sda.local/bounded-schema-evaluation.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "disposition", "schemaId", "declaredFields", "findings", "authorityClaims", "lineage"],
  "properties": {
    "contractId": {"const": "bounded-schema-evaluation.v1"},
    "disposition": {"enum": ["MATCHED", "REJECTED"]},
    "schemaId": {"type": "string"},
    "declaredFields": {"type": "array", "items": {"type": "string"}},
    "findings": {"type": "array", "items": {"type": "object"}},
    "authorityClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection", "promotion", "behavioralConformance"],
      "properties": {
        "projection": {"const": "NOT_CLAIMED"},
        "promotion": {"const": "NOT_CLAIMED"},
        "behavioralConformance": {"const": "NOT_CLAIMED"}
      }
    },
    "lineage": {"type": "array", "items": {"type": "string"}}
  }
}
