{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/json-ingestion/declared-json-schema-authority-resolver.authority.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "authorityType", "authorityId", "authorityRef", "authorityVersion", "lifecycle", "platformCapabilityId", "authorityDigest", "authorityDigestAlgorithm", "dialect", "resolutionRules", "providerObservation"],
  "properties": {
    "$schema": {"const": "contracts/declared-json-schema-authority-resolver.authority.schema.json"},
    "authorityType": {"const": "declared-json-schema-authority-resolver-authority.v1"},
    "authorityId": {"const": "declared-json-schema-authority-resolver.v1"},
    "authorityRef": {"const": "capabilities/sda-platform/resolve-declared-json-schema-authority/declared-json-schema-authority-resolver.authority.json"},
    "authorityVersion": {"const": "1.0.0"},
    "lifecycle": {"enum": ["PROPOSED", "ADMITTED"]},
    "platformCapabilityId": {"const": "sda-declared-json-schema-authority-resolver.v1"},
    "authorityDigest": {"$ref": "#/$defs/digest"},
    "authorityDigestAlgorithm": {"const": "sha256 of canonical recursive-key-order JSON excluding authorityDigest"},
    "dialect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaDialect", "formatAssertion", "ambientRemoteResolution", "exactSchemaBytesRequired"],
      "properties": {
        "schemaDialect": {"const": "https://json-schema.org/draft/2020-12/schema"},
        "formatAssertion": {"const": "DISABLED_UNLESS_EXPLICITLY_ADMITTED"},
        "ambientRemoteResolution": {"const": false},
        "exactSchemaBytesRequired": {"const": true}
      }
    },
    "resolutionRules": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "declared-schema-ref-and-digest-must-match-catalog",
          "schema-catalog-digest-must-be-current",
          "schema-dialect-must-be-admitted",
          "document-version-must-be-supported",
          "transitive-schema-reference-closure-must-be-admitted",
          "schema-instance-diagnostics-use-stable-pointers",
          "missing-schema-never-falls-back"
        ]
      }
    },
    "providerObservation": {"$ref": "#/$defs/providerObservation"}
  },
  "allOf": [
    {"if": {"properties": {"lifecycle": {"const": "ADMITTED"}}, "required": ["lifecycle"]}, "then": {"properties": {"providerObservation": {"properties": {"disposition": {"const": "SATISFIED"}}}}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "providerObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "providerSourceRef", "providerSourceDigest", "implementationVersion"],
      "properties": {
        "disposition": {"enum": ["SATISFIED", "NOT_OBSERVABLE"]},
        "providerSourceRef": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "providerSourceDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "implementationVersion": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
      },
      "allOf": [
        {"if": {"properties": {"disposition": {"const": "NOT_OBSERVABLE"}}, "required": ["disposition"]}, "then": {"properties": {"providerSourceRef": {"type": "null"}, "providerSourceDigest": {"type": "null"}, "implementationVersion": {"type": "null"}}}},
        {"if": {"properties": {"disposition": {"const": "SATISFIED"}}, "required": ["disposition"]}, "then": {"properties": {"providerSourceRef": {"type": "string", "minLength": 1}, "providerSourceDigest": {"$ref": "#/$defs/digest"}, "implementationVersion": {"type": "string", "minLength": 1}}}}
      ]
    }
  }
}
