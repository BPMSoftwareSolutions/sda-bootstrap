{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/gherkin/canonical-gherkin-compilation.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "source", "compiler", "grammar", "profile", "gherkinDocument", "comments", "compiledCases", "diagnostics", "astDigest", "caseDigest", "profileAdmissionDigest", "compilationDigest", "disposition", "authorityClaims"],
  "properties": {
    "contractId": {"const": "canonical-gherkin-compilation.v1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRef", "mediaType", "declaredDialect", "sourceBytesBase64", "sourceDigest"],
      "properties": {
        "sourceRef": {"type": "string", "minLength": 1},
        "mediaType": {"enum": ["text/x.cucumber.gherkin+plain", "text/x.cucumber.gherkin+markdown"]},
        "declaredDialect": {"type": "string", "minLength": 2},
        "sourceBytesBase64": {"type": "string", "contentEncoding": "base64"},
        "sourceDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "compiler": {"$ref": "#/$defs/versionedAuthority"},
    "grammar": {"$ref": "#/$defs/versionedAuthority"},
    "profile": {"$ref": "#/$defs/versionedAuthority"},
    "gherkinDocument": {"type": "object"},
    "comments": {"type": "array", "items": {"type": "object"}},
    "compiledCases": {"type": "array", "items": {"type": "object"}},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "astDigest": {"$ref": "#/$defs/digest"},
    "caseDigest": {"$ref": "#/$defs/digest"},
    "profileAdmissionDigest": {"$ref": "#/$defs/digest"},
    "compilationDigest": {"$ref": "#/$defs/digest"},
    "disposition": {"enum": ["BOUND", "PROFILE_HELD", "REJECTED", "STALE"]},
    "authorityClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection", "execution", "behavioralConformance", "companionClosure"],
      "properties": {
        "projection": {"const": "NOT_CLAIMED"},
        "execution": {"const": "NOT_CLAIMED"},
        "behavioralConformance": {"const": "NOT_CLAIMED"},
        "companionClosure": {"const": "NOT_CLAIMED"}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "versionedAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityId", "authorityVersion", "authorityDigest"],
      "properties": {
        "authorityId": {"type": "string", "minLength": 1},
        "authorityVersion": {"type": "string", "minLength": 1},
        "authorityDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "subjectRef", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "subjectRef": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "sourcePointer": {"type": "string"}
      }
    }
  }
}
