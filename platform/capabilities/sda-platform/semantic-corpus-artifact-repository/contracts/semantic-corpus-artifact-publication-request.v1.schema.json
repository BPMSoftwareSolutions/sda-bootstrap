{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/semantic-corpus/semantic-corpus-artifact-publication-request.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "repositoryAuthorityRef", "repositoryAuthorityDigest", "artifactKind", "artifactBytesBase64", "byteLength", "expectedDigest", "canonicalizationAuthorityId", "canonicalizationAuthorityDigest"],
  "properties": {
    "contractId": {"const": "semantic-corpus-artifact-publication-request.v1"},
    "repositoryAuthorityRef": {"$ref": "#/$defs/reference"},
    "repositoryAuthorityDigest": {"$ref": "#/$defs/digest"},
    "artifactKind": {"$ref": "#/$defs/artifactKind"},
    "artifactBytesBase64": {"$ref": "#/$defs/canonicalBase64"},
    "byteLength": {"type": "integer", "minimum": 1},
    "expectedDigest": {"$ref": "#/$defs/digest"},
    "canonicalizationAuthorityId": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*\\.v[0-9]+$"},
    "canonicalizationAuthorityDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "reference": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"},
    "canonicalBase64": {"type": "string", "minLength": 4, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$", "contentEncoding": "base64"},
    "artifactKind": {"enum": ["SOURCE_MANIFEST", "CORPUS_SNAPSHOT", "OBJECT_CATALOG", "RELATIONSHIP_GRAPH", "IDENTITY_INDEX", "LEXICAL_INDEX", "QUERY_RECEIPT", "AUTHORING_RECEIPT", "CLOSURE_RECEIPT", "PUBLICATION_RECEIPT"]}
  }
}
