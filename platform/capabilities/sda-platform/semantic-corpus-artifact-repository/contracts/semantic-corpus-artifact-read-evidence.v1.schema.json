{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/semantic-corpus/semantic-corpus-artifact-read-evidence.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "repositoryAuthorityDigest", "artifactKind", "canonicalizationAuthorityDigest", "requestedDigest", "observedDigest", "artifactBytesBase64", "byteLength", "readPurpose", "retentionEvidenceDigests", "findings", "disposition"],
  "properties": {
    "contractId": {"const": "semantic-corpus-artifact-read-evidence.v1"},
    "repositoryAuthorityDigest": {"$ref": "#/$defs/digest"},
    "artifactKind": {"$ref": "#/$defs/artifactKind"},
    "canonicalizationAuthorityDigest": {"$ref": "#/$defs/digest"},
    "requestedDigest": {"$ref": "#/$defs/digest"},
    "observedDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "artifactBytesBase64": {"oneOf": [{"$ref": "#/$defs/canonicalBase64"}, {"type": "null"}]},
    "byteLength": {"type": ["integer", "null"], "minimum": 0},
    "readPurpose": {"enum": ["DIRECT", "RETAINED_SNAPSHOT"]},
    "retentionEvidenceDigests": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "disposition": {"enum": ["READ", "MISSING", "CORRUPTED", "UNAUTHORIZED"]}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "canonicalBase64": {"type": "string", "minLength": 4, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$", "contentEncoding": "base64"},
    "artifactKind": {"enum": ["SOURCE_MANIFEST", "CORPUS_SNAPSHOT", "OBJECT_CATALOG", "RELATIONSHIP_GRAPH", "IDENTITY_INDEX", "LEXICAL_INDEX", "QUERY_RECEIPT", "AUTHORING_RECEIPT", "CLOSURE_RECEIPT", "PUBLICATION_RECEIPT"]},
    "finding": {"type": "object", "additionalProperties": false, "required": ["code", "subjectRef"], "properties": {"code": {"type": "string", "minLength": 1}, "subjectRef": {"type": "string", "minLength": 1}}}
  }
}
