{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/semantic-corpus/semantic-corpus-artifact-read-request.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "repositoryAuthorityRef", "repositoryAuthorityDigest", "artifactKind", "artifactDigest", "canonicalizationAuthorityId", "canonicalizationAuthorityDigest", "readPurpose", "retentionEvidence"],
  "properties": {
    "contractId": {"const": "semantic-corpus-artifact-read-request.v1"},
    "repositoryAuthorityRef": {"$ref": "#/$defs/reference"},
    "repositoryAuthorityDigest": {"$ref": "#/$defs/digest"},
    "artifactKind": {"$ref": "#/$defs/artifactKind"},
    "artifactDigest": {"$ref": "#/$defs/digest"},
    "canonicalizationAuthorityId": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*\\.v[0-9]+$"},
    "canonicalizationAuthorityDigest": {"$ref": "#/$defs/digest"},
    "readPurpose": {"enum": ["DIRECT", "RETAINED_SNAPSHOT"]},
    "retentionEvidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["receiptRef", "receiptDigest", "receiptContractId"],
        "properties": {
          "receiptRef": {"$ref": "#/$defs/contentAddress"},
          "receiptDigest": {"$ref": "#/$defs/digest"},
          "receiptContractId": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [{"if": {"type": "object", "properties": {"readPurpose": {"const": "RETAINED_SNAPSHOT"}}, "required": ["readPurpose"]}, "then": {"type": "object", "properties": {"artifactKind": {"const": "CORPUS_SNAPSHOT"}, "retentionEvidence": {"type": "array", "minItems": 1}}}}],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "reference": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"},
    "contentAddress": {"type": "string", "pattern": "^objects/[a-f0-9]{2}/[a-f0-9]{64}\\.json$"},
    "artifactKind": {"enum": ["SOURCE_MANIFEST", "CORPUS_SNAPSHOT", "OBJECT_CATALOG", "RELATIONSHIP_GRAPH", "IDENTITY_INDEX", "LEXICAL_INDEX", "QUERY_RECEIPT", "AUTHORING_RECEIPT", "CLOSURE_RECEIPT", "PUBLICATION_RECEIPT"]}
  }
}
