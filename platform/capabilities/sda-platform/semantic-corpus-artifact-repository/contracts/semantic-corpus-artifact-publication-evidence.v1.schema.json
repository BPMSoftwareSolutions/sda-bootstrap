{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/semantic-corpus/semantic-corpus-artifact-publication-evidence.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "repositoryAuthorityDigest", "artifactKind", "canonicalizationAuthorityDigest", "expectedDigest", "observedDigest", "byteLength", "contentAddress", "findings", "disposition"],
  "properties": {
    "contractId": {"const": "semantic-corpus-artifact-publication-evidence.v1"},
    "repositoryAuthorityDigest": {"$ref": "#/$defs/digest"},
    "artifactKind": {"$ref": "#/$defs/artifactKind"},
    "canonicalizationAuthorityDigest": {"$ref": "#/$defs/digest"},
    "expectedDigest": {"$ref": "#/$defs/digest"},
    "observedDigest": {"$ref": "#/$defs/nullableDigest"},
    "byteLength": {"type": ["integer", "null"], "minimum": 0},
    "contentAddress": {"oneOf": [{"$ref": "#/$defs/contentAddress"}, {"type": "null"}]},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "disposition": {"enum": ["PUBLISHED", "ALREADY_PRESENT", "REJECTED"]}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "nullableDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "contentAddress": {"type": "string", "pattern": "^objects/[a-f0-9]{2}/[a-f0-9]{64}\\.json$"},
    "artifactKind": {"enum": ["SOURCE_MANIFEST", "CORPUS_SNAPSHOT", "OBJECT_CATALOG", "RELATIONSHIP_GRAPH", "IDENTITY_INDEX", "LEXICAL_INDEX", "QUERY_RECEIPT", "AUTHORING_RECEIPT", "CLOSURE_RECEIPT", "PUBLICATION_RECEIPT"]},
    "finding": {"type": "object", "additionalProperties": false, "required": ["code", "subjectRef"], "properties": {"code": {"type": "string", "minLength": 1}, "subjectRef": {"type": "string", "minLength": 1}}}
  }
}
