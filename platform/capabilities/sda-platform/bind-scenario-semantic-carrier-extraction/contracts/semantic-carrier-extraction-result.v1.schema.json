{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/semantic-carrier/semantic-carrier-extraction-result.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "sourceId",
    "sourceDigest",
    "validatorReceiptDigest",
    "disposition",
    "graph",
    "graphDigest",
    "carrierBlackout",
    "findings",
    "receiptDigest"
  ],
  "properties": {
    "contractId": {
      "const": "semantic-carrier-extraction-result.v1"
    },
    "sourceId": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceDigest": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "validatorReceiptDigest": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "disposition": {
      "enum": [
        "EXTRACTED",
        "EXTRACTION_HELD"
      ]
    },
    "graph": {
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "graphDigest": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "carrierBlackout": {
      "const": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "path",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "receiptDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "EXTRACTED"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "graph": {
            "type": "object"
          },
          "graphDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "findings": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "EXTRACTION_HELD"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "graph": {
            "type": "null"
          },
          "graphDigest": {
            "type": "null"
          },
          "findings": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ]
}
