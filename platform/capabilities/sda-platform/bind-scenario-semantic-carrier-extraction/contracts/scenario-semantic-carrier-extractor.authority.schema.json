{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/semantic-carrier/scenario-semantic-carrier-extractor.authority.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "$schema",
    "authorityType",
    "authorityId",
    "authorityRef",
    "authorityVersion",
    "platformCapabilityId",
    "lifecycle",
    "authorityDigest",
    "inputContracts",
    "outputContracts",
    "responsibility",
    "prohibitedResponsibilities",
    "providerObservation"
  ],
  "properties": {
    "$schema": {
      "const": "contracts/scenario-semantic-carrier-extractor.authority.schema.json"
    },
    "authorityType": {
      "const": "scenario-semantic-carrier-extractor-provider-authority.v1"
    },
    "authorityId": {
      "type": "string",
      "minLength": 1
    },
    "authorityRef": {
      "const": "capabilities/sda-platform/bind-scenario-semantic-carrier-extraction/scenario-semantic-carrier-extractor.authority.json"
    },
    "authorityVersion": {
      "const": "1.0.0"
    },
    "platformCapabilityId": {
      "const": "sda-scenario-semantic-carrier-extraction-port.v1"
    },
    "lifecycle": {
      "const": "ADMITTED"
    },
    "authorityDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
