{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/semantic-carrier/semantic-carrier-extraction-request.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "payload"
  ],
  "properties": {
    "contractId": {
      "const": "semantic-carrier-extraction-request.v1"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "sourceId",
        "validatorReceipt"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "validatorReceipt": {
          "type": "object"
        }
      }
    }
  }
}
