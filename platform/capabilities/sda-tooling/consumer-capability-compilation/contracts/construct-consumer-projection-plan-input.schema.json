{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/tooling/construct-consumer-projection-plan-input.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceAdmission", "graph", "responsibilityEvidence", "targets", "preserveUntargeted"],
