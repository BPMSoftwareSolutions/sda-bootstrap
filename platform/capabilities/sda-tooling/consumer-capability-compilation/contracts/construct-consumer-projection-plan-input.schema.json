    "sourceAdmission": { "type": "object" },
    "graph": { "type": "object" },
    "responsibilityEvidence": { "type": "object" },
    "targets": { "type": "array", "minItems": 1 },
    "preserveUntargeted": { "type": "boolean" }
  }
}
