{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/kernel/observation-binding.v1.schema.json",
  "title": "Observable Condition Binding Authority",
  "description": "Operational authority binding semantic observable conditions to machine evaluators without leaking evaluator syntax into capability authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["bindingType", "bindings"],
  "properties": {
    "bindingType": { "const": "observation-bindings.v1" },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conditionId", "evaluatorId", "evidenceContractId"],
        "properties": {
          "conditionId": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" },
          "evaluatorId": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" },
          "evidenceContractId": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" },
          "configurationRef": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
