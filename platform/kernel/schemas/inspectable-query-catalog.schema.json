{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/kernel/inspectable-query-catalog.v1.schema.json",
  "title": "Inspectable Query Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractType", "catalogId", "queries"],
  "properties": {
    "contractType": { "const": "inspectable-query-catalog.v1" },
    "catalogId": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["queryId", "question", "status"],
        "properties": {
          "queryId": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" },
          "question": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["DECLARED", "IMPLEMENTED"] },
          "parameters": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "resultShape": { "type": "string", "minLength": 1 },
          "expression": { "$ref": "semantic-transformation-authority.schema.json#/$defs/expression" }
        },
        "allOf": [{
          "if": { "properties": { "status": { "const": "IMPLEMENTED" } } },
          "then": { "required": ["parameters", "resultShape", "expression"] }
        }]
      }
    }
  }
}
