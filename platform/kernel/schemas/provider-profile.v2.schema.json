{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/enterprise/provider-profile.v2.schema.json",
  "title": "SDA provider profile v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["profileType", "profileId", "profileDigest", "providerId", "mechanicIds", "implementationRef", "sourceAuthorityDigest", "effectClassification", "determinism", "conformanceRefs", "physicalPrimitiveProfiles"],
  "properties": {
    "profileType": { "const": "sda-provider-profile.v2" },
    "profileId": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" },
    "profileDigest": { "$ref": "semantic-primitives.schema.json#/$defs/digest" },
    "providerId": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" },
    "mechanicIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" } },
    "implementationRef": { "type": "string", "minLength": 1 },
    "sourceAuthorityDigest": { "$ref": "semantic-primitives.schema.json#/$defs/digest" },
    "effectClassification": { "type": "string", "enum": ["pure", "observation", "effect"] },
    "determinism": { "type": "string", "enum": ["deterministic", "testimony-governed"] },
    "conformanceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "physicalPrimitiveProfiles": { "type": "array", "uniqueItems": true, "items": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" } },
    "equivalenceClassId": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" }
  }
}
