{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/kernel/consumer-query-catalog-conformance.v1.schema.json",
  "title": "Observed Consumer Query Catalog Conformance",
  "type": "object",
  "additionalProperties": false,
  "required": ["conformanceType", "catalogId", "projectionTarget", "coverage", "queries", "disposition"],
  "properties": {
    "conformanceType": { "const": "consumer-query-catalog-conformance.v1" },
    "catalogId": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" },
    "projectionTarget": { "type": "string", "enum": ["node", "csharp", "python", "java"] },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "implemented", "observed"],
      "properties": {
        "declared": { "type": "integer", "minimum": 0 },
        "implemented": { "type": "integer", "minimum": 0 },
        "observed": { "type": "integer", "minimum": 0 }
      }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["queryId", "fixtureId", "params", "result", "assertions", "disposition"],
        "properties": {
          "queryId": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" },
          "fixtureId": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" },
          "params": { "type": "object" },
          "result": {},
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "operator", "expected", "actual", "satisfied"],
              "properties": {
                "path": { "type": "string" },
                "operator": { "type": "string", "enum": ["equals", "contains", "not-contains"] },
                "expected": {},
                "actual": {},
                "satisfied": { "type": "boolean" }
              }
            }
          },
          "disposition": { "type": "string", "enum": ["OBSERVED", "NOT_OBSERVED"] }
        }
      }
    },
    "disposition": { "type": "string", "enum": ["ALL_IMPLEMENTED_QUERIES_OBSERVED", "QUERY_CATALOG_GAP"] }
  }
}
