{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/kernel/authority-source-inspection-profile.v1.schema.json",
  "title": "Registered Authority Source Inspection Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["authorityType", "target", "checks"],
  "properties": {
    "authorityType": { "const": "authority-source-inspection-profile.v1" },
    "target": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "pattern"],
        "properties": {
          "value": { "type": "string", "minLength": 1 },
          "pattern": { "type": "string", "minLength": 1 },
          "flags": { "type": "string", "pattern": "^[dimsuvy]*$" }
        }
      }
    }
  }
}
