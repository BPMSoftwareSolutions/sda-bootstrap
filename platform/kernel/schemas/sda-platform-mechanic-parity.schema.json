{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/kernel/sda-platform-mechanic-parity.v1.schema.json",
  "title": "SDA Platform Mechanic Parity Authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["parityType", "profileId", "appliesToBindingStatuses", "requiredMechanics"],
  "properties": {
    "parityType": { "const": "sda-platform-mechanic-parity.v1" },
    "profileId": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" },
    "appliesToBindingStatuses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["IMPLEMENTING"] }
    },
    "requiredMechanics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" }
    }
  }
}
