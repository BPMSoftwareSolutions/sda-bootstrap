{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/kernel/consumer-ui-authority-identity.v1.schema.json",
  "title": "Consumer UI Authority Identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["identityType", "authorityRef", "uiAuthorityType", "applicationId", "experienceConditionIds", "canonicalization", "authorityDigest"],
  "properties": {
    "identityType": { "const": "consumer-ui-authority-identity.v1" },
    "authorityRef": { "type": "string", "minLength": 1 },
    "uiAuthorityType": { "const": "consumer-ui-authority.v1" },
    "applicationId": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" },
    "experienceConditionIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" }
    },
    "canonicalization": { "const": "recursive-key-order.v1" },
    "authorityDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
