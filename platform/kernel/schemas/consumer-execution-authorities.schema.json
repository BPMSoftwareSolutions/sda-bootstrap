{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/kernel/consumer-execution-authorities.v1.schema.json",
  "title": "Consumer Execution Authorities",
  "description": "Semantic instructions from which consumer runtime bodies are projected; contains no executable functions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["authorityType", "executionAuthorities"],
  "properties": {
    "authorityType": { "const": "execution-authorities.v1" },
    "executionAuthorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owningScenarioId", "operations"],
        "properties": {
          "id": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" },
          "owningScenarioId": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" },
          "operations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "portId"],
                  "properties": {
                    "kind": { "const": "invoke-port" },
                    "portId": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "scenarioId"],
                  "properties": {
                    "kind": { "const": "invoke-scenario" },
                    "scenarioId": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "projectionId"],
                  "properties": {
                    "kind": { "const": "project-state" },
                    "projectionId": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
