{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/kernel/capability.v1.schema.json",
  "title": "Scenario-Driven Capability",
  "description": "Canonical capability contract composed of governed scenarios, transitions, and interfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": ["capabilityType", "capabilityId", "userStory", "scenarios"],
  "properties": {
    "capabilityType": {
      "const": "scenario-driven-capability.v1"
    },
    "capabilityId": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" },
    "name": { "type": "string", "minLength": 1 },
    "mode": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["feature", "capability", "system"]
      }
    },
    "userStory": { "$ref": "user-story.schema.json" },
    "experience": { "$ref": "promised-experience.schema.json" },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 }
      }
    },
    "interfaces": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "interface-binding.schema.json" }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "scenario.schema.json" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["scenarioId"],
            "properties": {
              "scenarioId": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" }
            }
          }
        ]
      }
    },
    "transitions": {
      "type": "array",
      "items": { "$ref": "scenario-transition.schema.json" }
    },
    "rootScenarioId": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" }
  }
}
