{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/kernel/language-target-registration.v1.schema.json",
  "title": "SDA Language Target Registration",
  "description": "Admits one discoverable language projection target and binds its target-owned providers and policies without extending a central language enum.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registrationType",
    "targetId",
    "displayName",
    "status",
    "bindingRef",
    "projectionProfileRef",
    "toolchainProfileRef",
    "admittedStructuralSource",
    "promotion",
    "providers",
    "supportedContracts"
  ],
  "properties": {
    "registrationType": { "const": "language-target-registration.v1" },
    "targetId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["DECLARED", "IMPLEMENTING"] },
    "bindingRef": { "$ref": "#/$defs/relativeRef" },
    "projectionProfileRef": { "$ref": "#/$defs/relativeRef" },
    "toolchainProfileRef": { "$ref": "#/$defs/relativeRef" },
    "admittedStructuralSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "extensions"],
      "properties": {
        "directory": { "$ref": "#/$defs/relativeRef" },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^\\.[A-Za-z0-9.]+$" }
        },
        "excludedFiles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structuralOutputDirectory", "preserveExistingStructuralFiles", "managedExtensions"],
      "properties": {
        "structuralOutputDirectory": { "$ref": "#/$defs/relativeRef" },
        "structuralProfileOverrides": { "type": "object" },
        "preserveExistingStructuralFiles": { "type": "boolean" },
        "managedExtensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^\\.[A-Za-z0-9.]+$" }
        }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structuralRenderer", "executionRenderer", "shapeObserver"],
      "properties": {
        "structuralRenderer": { "$ref": "#/$defs/provider" },
        "executionRenderer": { "$ref": "#/$defs/provider" },
        "shapeObserver": { "$ref": "#/$defs/provider" },
        "sourceMechanicObserver": { "$ref": "#/$defs/provider" },
        "toolchainDriver": { "$ref": "#/$defs/provider" }
      }
    },
    "supportedContracts": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 },
      "minProperties": 1
    }
  },
  "$defs": {
    "relativeRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "transport", "implementationRef", "implementationDigest"],
      "properties": {
        "providerId": { "type": "string", "minLength": 1 },
        "transport": { "type": "string", "enum": ["builtin", "process-json-v1"] },
        "implementationRef": { "$ref": "#/$defs/relativeRef" },
        "implementationDigest": { "$ref": "#/$defs/digest" },
        "operation": { "type": "string", "minLength": 1 },
        "authorityRef": { "$ref": "#/$defs/relativeRef" },
        "authorityDigest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
