{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/kernel/capability.v3.schema.json",
  "title": "Scenario-Driven Capability v3",
  "description": "A governed composition of v2 scenarios using versioned canonical interface bindings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["capabilityType", "capabilityId", "purpose", "consumer", "interfaces", "scenarios"],
  "properties": {
    "capabilityType": { "const": "scenario-driven-capability.v3" },
    "capabilityId": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" },
    "name": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor"],
      "properties": { "actor": { "type": "string", "minLength": 1 } }
    },
    "interfaces": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "interface-binding.v2.schema.json" }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "scenario.v2.schema.json" }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceVersion", "derivation"],
      "properties": {
        "sourceVersion": { "enum": ["v1", "v2"] },
        "derivation": { "const": "legacy-derived" }
      }
    }
  }
}
