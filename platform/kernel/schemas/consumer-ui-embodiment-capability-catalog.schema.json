{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/kernel/consumer-ui-embodiment-capability-catalog.v1.schema.json",
  "title": "Consumer UI Embodiment Capability Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogType", "capabilities"],
  "properties": {
    "catalogType": { "const": "consumer-ui-embodiment-capability-catalog.v1" },
    "capabilities": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capabilityId", "kind", "status", "implementationDisposition", "embodimentTarget", "provider", "providesMechanics", "implementationRef", "conformanceRef", "staticConformanceRef"],
        "properties": {
          "capabilityId": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" },
          "kind": { "const": "ui-embodiment" },
          "status": { "type": "string", "enum": ["ADMITTED", "DECLARED"] },
          "implementationDisposition": {
            "type": "string",
            "enum": ["NATIVE_PROOF_ADMITTED", "IMPLEMENTED_AWAITING_NATIVE_PROOF"]
          },
          "embodimentTarget": { "$ref": "consumer-ui-parity-evidence.schema.json#/$defs/target" },
          "provider": { "type": "string", "minLength": 1 },
          "providesMechanics": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" }
          },
          "implementationRef": { "type": "string", "minLength": 1 },
          "conformanceRef": { "type": "string", "minLength": 1 },
          "staticConformanceRef": { "type": "string", "minLength": 1 },
          "projectionProfileRef": { "type": "string", "minLength": 1 },
          "toolchainRequirements": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
