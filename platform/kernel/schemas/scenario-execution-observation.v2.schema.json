{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scenario-driven.dev/kernel/scenario-execution-observation.v2.schema.json",
  "title": "Graph-addressed cell protocol observation v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["observationType", "graphId", "canonicalGraphDigest", "cellId", "cellExecutionId", "rootExecutionId", "stepId", "sequence", "status", "logicalOrder"],
  "properties": {
    "observationType": { "const": "scenario-execution-observation.v2" },
    "graphId": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" },
    "canonicalGraphDigest": { "$ref": "semantic-primitives.schema.json#/$defs/digest" },
    "cellId": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" },
    "cellExecutionId": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" },
    "rootExecutionId": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" },
    "parentCellExecutionId": { "oneOf": [{ "$ref": "semantic-primitives.schema.json#/$defs/semanticId" }, { "type": "null" }] },
    "edgeId": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" },
    "stepId": { "$ref": "semantic-primitives.schema.json#/$defs/semanticId" },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 4 },
    "status": { "type": "string", "enum": ["observed", "admission-rejected", "authority-resolution-failed", "execution-failed", "cancelled"] },
    "logicalOrder": { "type": "integer", "minimum": 0 }
  }
}
